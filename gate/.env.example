# Copy to .env (never commit it). THROWAWAY TESTNET KEYS ONLY: never put a key that ever held real funds here.
# PAYER_PK     signs the authorization; needs >= 0.01 test USDT (swap WBT -> USDT on YetiTrade). Needs no WBT.
# RECEIVER_PK  submits the transaction (msg.sender == to) and pays gas; needs about 0.01 test WBT from the faucet.
PAYER_PK=0x
RECEIVER_PK=0x
# Optional overrides
# RPC_URL=https://rpc.testnet.whitechain.io
# AMOUNT_UNITS=10000
