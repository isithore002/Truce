# Copy to .env.local. No secrets belong here: the browser only signs typed data.
VITE_API_BASE=http://localhost:8787
# mock = built-in scenario adapter (no keys, no network); server = real apps/server HTTP API
VITE_API_MODE=mock
# Shows /demo, the scenario switcher and tamper tools
VITE_DEMO_TOOLS=1
# Forces the EXAMPLE DATA banner on every page
VITE_EXAMPLE_MODE=1
# Due-date payments and the mocked Soul badge (on by default; set 0 to hide)
VITE_FEATURE_DUE_DATE=1
VITE_FEATURE_SOUL_BADGE=1
