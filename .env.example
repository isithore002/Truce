# Copy to .env (git-ignored). THROWAWAY TESTNET KEYS ONLY: never a key that ever held real funds.
# Never paste a key into chat, an issue or a commit. Testnet only (chain 1874).
#
# Load for forge:  set -a; source .env; set +a      (Git Bash)
# Run the e2e:     npm run e2e

# Deployer pays WBT gas for the one-time deployment.
DEPLOYER_PK=0x
# Contract owner address. Can only pause and unpause new settlements. May be the deployer's address.
OWNER=0x

# Signs invoices (the merchant's signing wallet).
MERCHANT_PK=0x
# Signs the EIP-3009 payment authorization; needs test USDT (swap WBT -> USDT on YetiTrade), no WBT.
PAYER_PK=0x
# Submits settle() and pays gas in WBT. Needs about 0.01 test WBT.
RELAYER_PK=0x

# Optional
# PAYOUT_ADDRESS=0x     where the merchant is paid (default: the merchant signing address)
# AMOUNT_UNITS=10000    token base units, 6 decimals (10000 = 0.01 USDT)
# SETTLER_ADDRESS=0x    overrides deployments/whitechain-sepolia.json
# RPC_URL=https://rpc.testnet.whitechain.io
